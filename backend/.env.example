# Copy to backend/.env (gitignored) and fill in. Never commit the real file.

# --- Gmail SMTP sender for low-stock alerts and the end-of-day report ---
# The Gmail account must have 2-Step Verification on. Create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (spaces are fine).
SMTP_USER=yourstore@gmail.com
SMTP_APP_PASSWORD=
# Optional overrides
# SMTP_FROM_NAME=Break & Brews
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Link used by the "Open the admin dashboard" buttons in emails.
# ADMIN_PORTAL_URL=http://localhost:5173

# Defaults for the first run only; afterwards closing time and time zone are edited in the admin portal.
# STORE_CLOSING_TIME=22:00
# STORE_TIMEZONE=Asia/Manila

# Public links used inside customer emails (new-menu announcements).
# CUSTOMER_PORTAL_URL is where "See it on the menu" goes; PUBLIC_API_URL hosts the unsubscribe page.
# PUBLIC_API_URL defaults to the address the admin portal used to reach the API.
# CUSTOMER_PORTAL_URL=http://localhost:5176
# PUBLIC_API_URL=http://localhost:5001/api

# --- AI sales insights (admin portal > Sales Insights) ---
# Anthropic API key from https://platform.claude.com. Without it the forecast and stock outlook still
# work; only the Claude suggestions (web search for local news, events and prices) are switched off.
ANTHROPIC_API_KEY=
# Optional overrides
# AI_INSIGHTS_MODEL=claude-opus-5-5
# AI_INSIGHTS_EFFORT=high          # low | medium | high | xhigh | max; lower is cheaper
# AI_INSIGHTS_HOUR=6               # store-local hour for the automatic daily run
# AI_INSIGHTS_MAX_SEARCHES=8       # web searches per run
# AI_INSIGHTS_COOLDOWN_MINUTES=10  # minimum gap between manual runs
# Store location for weather and local news (first run only; edited in the portal afterwards).
# STORE_LOCATION=Pagadian City, Zamboanga del Sur
# STORE_LATITUDE=7.8257
# STORE_LONGITUDE=123.4370
