# Copy to .env to override the docker compose defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=break_and_brews

# Host port for the database container (container-side is always 5432).
DB_PORT=5434

SECRET_KEY=break-and-brews-super-secret-key-9876

# Set to 1 to drop and re-seed the database on the next backend start.
SEED_ON_START=0
